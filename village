#!/usr/bin/env bash
# AI Agent Village — single command-line entry point.
# Local-only (127.0.0.1). This script never runs sudo and never installs system packages.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
cd "$ROOT"

VENV="$ROOT/.venv"
PY="$VENV/bin/python"
BACKEND="$ROOT/backend"
FRONTEND="$ROOT/frontend"
ENV_FILE="${VILLAGE_ENV_FILE:-$ROOT/data/.env}"
PID_FILE="$ROOT/run/village.pid"

# Defaults; replaced by load_config with the validated application settings.
HOST="127.0.0.1"
PORT="8000"
DB_FILE="$ROOT/data/village.db"
LOG_DIR="$ROOT/logs"

MIN_PYTHON="3.12"
MIN_NODE=20

# ---------------------------------------------------------------- helpers

info() { printf '%s\n' "$*"; }
step() { printf '==> %s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }
die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

python_ok() {
  command -v python3 >/dev/null 2>&1 &&
    python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 12) else 1)' 2>/dev/null
}

node_major() {
  command -v node >/dev/null 2>&1 || return 1
  node -p 'process.versions.node.split(".")[0]' 2>/dev/null
}

node_ok() {
  local major
  major="$(node_major)" || return 1
  [[ "$major" =~ ^[0-9]+$ ]] && ((major >= MIN_NODE))
}

node_hint() {
  info "  Node.js >= $MIN_NODE with npm is required to build the frontend. Install it with:"
  info "    curl -fsSL https://deb.nodesource.com/setup_22.x | sudo -E bash - && sudo apt install -y nodejs"
}

# Read validated, non-secret settings (host, port, db file, log dir) from the app config.
load_config() {
  local out key value
  [[ -x "$PY" ]] || return 1
  out="$(cd "$BACKEND" && "$PY" -m app.config)" || return 1
  while IFS='=' read -r key value; do
    case "$key" in
      host) HOST="$value" ;;
      port) PORT="$value" ;;
      db_file) DB_FILE="$value" ;;
      log_dir) LOG_DIR="$value" ;;
    esac
  done <<<"$out"
}

log_file() { printf '%s/village.log' "$LOG_DIR"; }

base_url() {
  if [[ "$HOST" == *:* ]]; then printf 'http://[%s]:%s' "$HOST" "$PORT"; else printf 'http://%s:%s' "$HOST" "$PORT"; fi
}

read_pid() {
  [[ -f "$PID_FILE" ]] || return 0
  tr -cd '0-9' <"$PID_FILE"
}

# True when PID is alive AND is this checkout's Village server (guards against PID reuse).
is_village_pid() {
  local pid="${1:-}"
  [[ -n "$pid" ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  [[ -r "/proc/$pid/cmdline" ]] || return 1
  tr '\0' ' ' <"/proc/$pid/cmdline" | grep -q 'app\.main' || return 1
  [[ "$(readlink "/proc/$pid/cwd" 2>/dev/null)" == "$BACKEND" ]]
}

running_pid() {
  local pid
  pid="$(read_pid)"
  is_village_pid "$pid" || return 1
  printf '%s' "$pid"
}

# Prints the /api/health body. Exit 0 = healthy (HTTP 200), 2 = answered but unhealthy, 1 = no answer.
health_json() {
  python3 - "$(base_url)" <<'PYEOF'
import sys
import urllib.error
import urllib.request

opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
try:
    with opener.open(sys.argv[1] + "/api/health", timeout=2) as response:
        body = response.read().decode("utf-8", "replace")
except urllib.error.HTTPError as exc:
    print(exc.read().decode("utf-8", "replace"))
    sys.exit(2)
except Exception:
    sys.exit(1)
print(body)
sys.exit(0 if '"setup_completed"' in body else 2)
PYEOF
}

# True when the configured port can be bound (same socket options as uvicorn).
port_free() {
  python3 - "$HOST" "$PORT" <<'PYEOF'
import socket
import sys

host, port = sys.argv[1], int(sys.argv[2])
family = socket.AF_INET6 if ":" in host else socket.AF_INET
with socket.socket(family, socket.SOCK_STREAM) as sock:
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        sock.bind((host, port))
    except OSError:
        sys.exit(1)
PYEOF
}

format_uptime() {
  local total="$1" d h m s out=""
  d=$((total / 86400))
  h=$((total % 86400 / 3600))
  m=$((total % 3600 / 60))
  s=$((total % 60))
  ((d > 0)) && out+="${d}d "
  ((d > 0 || h > 0)) && out+="${h}h "
  ((d > 0 || h > 0 || m > 0)) && out+="${m}m "
  printf '%s%ss' "$out" "$s"
}

# ---------------------------------------------------------------- setup

cmd_setup() {
  step "Checking Python"
  command -v python3 >/dev/null 2>&1 || {
    info "  python3 was not found. Install it with:"
    info "    sudo apt install python3 python3-venv"
    exit 1
  }
  python_ok || die "Python >= $MIN_PYTHON is required (found $(python3 --version 2>&1))."
  if ! python3 -c 'import venv, ensurepip' 2>/dev/null; then
    info "  The Python venv module is missing. Install it with:"
    info "    sudo apt install python3-venv"
    exit 1
  fi
  info "  $(python3 --version 2>&1)"

  step "Python virtual environment"
  if [[ -x "$PY" ]]; then
    info "  .venv already exists"
  else
    python3 -m venv "$VENV"
    info "  created .venv"
  fi

  step "Installing backend dependencies"
  "$PY" -m pip install --quiet --disable-pip-version-check -r "$BACKEND/requirements.txt"
  info "  backend dependencies installed"

  step "Local data directories"
  mkdir -p "$ROOT/data" "$ROOT/logs" "$ROOT/run"
  info "  data/ logs/ run/ ready"

  step "Secrets file"
  if [[ -e "$ENV_FILE" ]]; then
    info "  $ENV_FILE already exists — left untouched"
    if [[ "$(stat -c '%a' "$ENV_FILE")" != "600" ]]; then
      chmod 600 "$ENV_FILE"
      info "  permissions tightened to 600 (contents unchanged)"
    fi
  else
    mkdir -p "$(dirname "$ENV_FILE")"
    (
      umask 077
      printf 'VILLAGE_SECRET_KEY=%s\n' "$(python3 -c 'import secrets; print(secrets.token_urlsafe(48))')" >"$ENV_FILE"
    )
    chmod 600 "$ENV_FILE"
    info "  created $ENV_FILE (mode 600) with a new random secret key"
  fi
  if ! load_config; then
    info "  The configuration is not valid (see the message above)."
    info "  If VILLAGE_SECRET_KEY is missing, add this line to $ENV_FILE yourself:"
    info "    VILLAGE_SECRET_KEY=<output of: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'>"
    exit 1
  fi

  step "Database migrations"
  (cd "$BACKEND" && "$VENV/bin/alembic" upgrade head)
  info "  database at head: $DB_FILE"

  step "Frontend"
  if [[ -f "$FRONTEND/package.json" ]]; then
    if ! node_ok || ! command -v npm >/dev/null 2>&1; then
      node_hint
      exit 1
    fi
    info "  node $(node --version), npm $(npm --version)"
    if [[ -f "$FRONTEND/package-lock.json" ]]; then
      (cd "$FRONTEND" && npm ci --no-audit --no-fund)
    else
      (cd "$FRONTEND" && npm install --no-audit --no-fund)
    fi
    (cd "$FRONTEND" && npm run build)
    info "  frontend built: $FRONTEND/dist"
  else
    info "  frontend/package.json not found — skipping the frontend build"
  fi

  info ""
  info "Setup complete. Next:  ./village start"
}

# ---------------------------------------------------------------- start / stop / restart

cmd_start() {
  local pid log i health
  load_config 2>/dev/null || true
  if pid="$(running_pid)"; then
    info "Village is already running (PID $pid) at $(base_url)"
    exit 1
  fi
  [[ -x "$PY" ]] || die "The Village is not set up yet. Run: ./village setup"
  load_config || die "The configuration is missing or invalid. Run: ./village setup"
  rm -f "$PID_FILE" # stale
  port_free || die "Port $PORT on $HOST is in use by another program. Free it, or set VILLAGE_PORT in $ENV_FILE."

  mkdir -p "$LOG_DIR" "$ROOT/run"
  log="$(log_file)"
  (
    cd "$BACKEND"
    if command -v setsid >/dev/null 2>&1; then
      exec nohup setsid "$PY" -m app.main >>"$log" 2>&1 </dev/null
    else
      exec nohup "$PY" -m app.main >>"$log" 2>&1 </dev/null
    fi
  ) &
  pid=$!
  printf '%s\n' "$pid" >"$PID_FILE"

  health=""
  for ((i = 0; i < 30; i++)); do # up to 15 s
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$PID_FILE"
      info "Village failed to start. Last log lines ($log):"
      tail -n 20 "$log" 2>/dev/null || true
      exit 1
    fi
    if health="$(health_json)"; then
      break
    fi
    health=""
    sleep 0.5
  done

  if [[ -z "$health" ]]; then
    info "Village did not become healthy within 15 s — stopping it."
    info "If the database is missing or out of date, run: ./village setup"
    cmd_stop >/dev/null 2>&1 || true
    info "Last log lines ($log):"
    tail -n 20 "$log" 2>/dev/null || true
    exit 1
  fi

  info "Village is running"
  info "  URL:    $(base_url)"
  info "  PID:    $pid"
  info "  Logs:   $log   (./village logs)"
  info "  Health: $health"
}

cmd_stop() {
  local pid i
  pid="$(read_pid)"
  if [[ -z "$pid" ]]; then
    rm -f "$PID_FILE"
    info "Village is not running."
    return 0
  fi
  if ! is_village_pid "$pid"; then
    rm -f "$PID_FILE"
    info "Village is not running (removed stale PID file for process $pid)."
    return 0
  fi
  kill -TERM "$pid" 2>/dev/null || true
  for ((i = 0; i < 50; i++)); do # up to 10 s
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.2
  done
  if kill -0 "$pid" 2>/dev/null; then
    warn "PID $pid did not stop within 10 s — sending SIGKILL"
    kill -KILL "$pid" 2>/dev/null || true
    sleep 0.5
  fi
  rm -f "$PID_FILE"
  info "Village stopped (PID $pid)."
}

cmd_restart() {
  cmd_stop
  cmd_start
}

# ---------------------------------------------------------------- status / logs

cmd_status() {
  local pid uptime health rc
  load_config 2>/dev/null || true
  if ! pid="$(running_pid)"; then
    if [[ -f "$PID_FILE" ]]; then
      rm -f "$PID_FILE"
      info "Village: stopped (removed stale PID file)"
    else
      info "Village: stopped"
    fi
    return 3
  fi
  uptime="$(ps -o etimes= -p "$pid" 2>/dev/null | tr -d ' ')"
  rc=0
  health="$(health_json)" || rc=$?
  info "Village: running"
  info "  URL:    $(base_url)"
  info "  PID:    $pid"
  info "  Uptime: $(format_uptime "${uptime:-0}")"
  case "$rc" in
    0) info "  Health: ok  $health" ;;
    2) info "  Health: DEGRADED  $health" ;;
    *) info "  Health: NOT RESPONDING on $(base_url)/api/health" ;;
  esac
  info "  Logs:   $(log_file)"
}

cmd_logs() {
  local log
  load_config 2>/dev/null || true
  log="$(log_file)"
  [[ -f "$log" ]] || die "No log file yet at $log (start the Village first)."
  case "${1:-}" in
    -f | --follow) exec tail -n 100 -f "$log" ;;
    "") tail -n 100 "$log" ;;
    *) die "Unknown option for logs: $1 (use: ./village logs [-f])" ;;
  esac
}

# ---------------------------------------------------------------- doctor

FAILS=0
report() {
  printf '%-4s  %s\n' "$1" "$2"
  if [[ "$1" == "FAIL" ]]; then FAILS=$((FAILS + 1)); fi
}

cmd_doctor() {
  local pid major mode avail_kb dbinfo db_exists="" current="" head="" journal="" key value deps_ok=0 built=0

  # python
  if python_ok; then
    report PASS "python: $(python3 --version 2>&1)"
  else
    report FAIL "python: python3 >= $MIN_PYTHON not found (sudo apt install python3 python3-venv)"
  fi

  # venv
  if [[ -x "$PY" ]]; then
    report PASS "venv: .venv present"
  else
    report FAIL "venv: .venv missing (run ./village setup)"
  fi

  # deps
  if [[ -x "$PY" ]] && "$PY" -c 'import fastapi, uvicorn, sqlalchemy, alembic, pydantic_settings, argon2' 2>/dev/null; then
    deps_ok=1
    report PASS "deps: backend packages import cleanly"
  else
    report FAIL "deps: backend packages missing (run ./village setup)"
  fi

  # frontend build state (reported after node)
  [[ -f "$FRONTEND/dist/index.html" ]] && built=1

  # node
  if node_ok; then
    report PASS "node: $(node --version)"
  elif major="$(node_major)"; then
    if ((built)); then
      report WARN "node: v$major is older than $MIN_NODE (only needed to rebuild the frontend)"
    else
      report FAIL "node: v$major is older than $MIN_NODE"
    fi
  elif ((built)); then
    report WARN "node: not installed (only needed to rebuild the frontend)"
  else
    report FAIL "node: not installed (needed to build the frontend)"
  fi

  # frontend built
  if ((built)); then
    report PASS "frontend: built (frontend/dist/index.html)"
  elif [[ -f "$FRONTEND/package.json" ]]; then
    report FAIL "frontend: not built (run ./village setup)"
  else
    report WARN "frontend: frontend/ does not exist yet"
  fi

  # config + port
  if ((deps_ok)) && load_config 2>/dev/null; then
    if pid="$(running_pid)"; then
      report PASS "port: $PORT is in use by the Village (PID $pid)"
    elif port_free; then
      report PASS "port: $PORT is free on $HOST"
    else
      report FAIL "port: $PORT on $HOST is in use by another program"
    fi
  else
    report FAIL "port: cannot check — configuration missing or invalid (run ./village setup)"
  fi

  # data dir
  if [[ -d "$ROOT/data" && -w "$ROOT/data" ]]; then
    report PASS "data: data/ is writable"
  else
    report FAIL "data: data/ is missing or not writable (run ./village setup)"
  fi

  # secrets file
  if [[ -f "$ENV_FILE" ]]; then
    mode="$(stat -c '%a' "$ENV_FILE")"
    if [[ "$mode" == "600" ]]; then
      report PASS "secrets: $ENV_FILE has mode 600"
    else
      report FAIL "secrets: $ENV_FILE has mode $mode, expected 600 (chmod 600 \"$ENV_FILE\")"
    fi
  else
    report FAIL "secrets: $ENV_FILE is missing (run ./village setup)"
  fi

  # migration + WAL
  if ((deps_ok)) && dbinfo="$(cd "$BACKEND" && "$PY" -m app.dbcheck 2>/dev/null)"; then
    while IFS='=' read -r key value; do
      case "$key" in
        db_exists) db_exists="$value" ;;
        current) current="$value" ;;
        head) head="$value" ;;
        journal_mode) journal="$value" ;;
      esac
    done <<<"$dbinfo"
    if [[ "$db_exists" != "yes" ]]; then
      report FAIL "migration: database not created yet (run ./village setup)"
      report FAIL "wal: database not created yet"
    else
      if [[ "$current" == "$head" ]]; then
        report PASS "migration: at head ($current)"
      else
        report FAIL "migration: at $current, head is $head (run ./village setup)"
      fi
      if [[ "$journal" == "wal" ]]; then
        report PASS "wal: journal_mode=wal"
      else
        report FAIL "wal: journal_mode=$journal"
      fi
    fi
  else
    report FAIL "migration: cannot inspect the database (run ./village setup)"
    report FAIL "wal: cannot inspect the database"
  fi

  # memory
  avail_kb="$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo 2>/dev/null || true)"
  if [[ -z "$avail_kb" ]]; then
    report WARN "memory: could not read /proc/meminfo"
  elif ((avail_kb < 1048576)); then
    report WARN "memory: only $((avail_kb / 1024)) MB available (< 1 GB)"
  else
    report PASS "memory: $((avail_kb / 1024)) MB available"
  fi

  if ((FAILS > 0)); then
    info ""
    info "doctor: $FAILS check(s) FAILED"
    return 1
  fi
  info ""
  info "doctor: no failures"
}

# ---------------------------------------------------------------- usage / dispatch

usage() {
  cat <<'USAGE'
AI Agent Village — local control command

Usage: ./village <command>

  setup      Install dependencies, create data/.env, migrate the database, build the frontend
             (safe to run again; never overwrites data/.env, never asks for root)
  start      Start the Village in the background on http://127.0.0.1:8000
  stop       Stop the Village
  restart    Stop, then start
  status     Show running/stopped, PID, uptime and health (exit code 3 when stopped)
  logs       Show the last 100 log lines (logs -f to follow)
  doctor     Run environment checks (PASS / WARN / FAIL); non-zero exit on any FAIL
  backup     Coming in M8
  restore    Coming in M8
  help       Show this help
USAGE
}

main() {
  local command="${1:-help}"
  [[ $# -gt 0 ]] && shift
  case "$command" in
    setup) cmd_setup "$@" ;;
    start) cmd_start "$@" ;;
    stop) cmd_stop "$@" ;;
    restart) cmd_restart "$@" ;;
    status) cmd_status "$@" ;;
    logs) cmd_logs "$@" ;;
    doctor) cmd_doctor "$@" ;;
    backup | restore) info "$command: coming in M8" ;;
    help | -h | --help) usage ;;
    *)
      printf 'Unknown command: %s\n\n' "$command" >&2
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
